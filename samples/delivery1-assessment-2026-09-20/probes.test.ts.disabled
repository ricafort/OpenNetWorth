import {beforeEach,afterEach,it,expect} from 'vitest';
import {createTestDb,setTestDb} from '../../src/infrastructure/sqlite/db';
import {initAccountingSchema} from '../../src/lib/domain/accounting/schema';
import {createEntity,createAccount} from '../../src/lib/domain/accounting/accountService';
import {recordBalanceObservation,getReconciliationComparison,recordSourceMapping} from '../../src/lib/domain/accounting/balanceObservationService';
import {parseStructuredTable} from '../../src/lib/domain/accounting/structuredBalanceParser';
import {getSharedFinancialSummary} from '../../src/lib/domain/accounting/sharedFinancialSummaryService';
import {POST as commit} from '../../src/app/api/accounting/balances/route';
import {POST as parse} from '../../src/app/api/accounting/balances/parse-table/route';
import {GET as exportVault,POST as restoreVault} from '../../src/app/api/vault/route';
let db:ReturnType<typeof createTestDb>, entity:string,account:string;
beforeEach(()=>{db=createTestDb();initAccountingSchema(db);setTestDb(db);entity=createEntity(db,{name:'Household',type:'household',currency:'AUD'}).id;account=createAccount(db,{entity_id:entity,name:'Savings',type:'asset',sub_type:'savings',currency:'AUD',tracking_mode:'balance',opening_date:'2026-01-01'}).account.id;});
afterEach(()=>{setTestDb(null);db.close();});
const obs=(extras:any={})=>({account_id:account,amount_cents:10000,currency:'AUD',balance_kind:'current_balance' as const,effective_date:'2026-09-19',source_type:'table_paste' as const,...extras});
const req=(body:any)=>new Request('http://localhost/api',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
it('P01 marks absent source date and ambiguous dollar currency unresolved',()=>{const p=parseStructuredTable('Savings, $100').proposals[0];expect(p.unresolved_fields.length).toBeGreaterThan(0);});
it('P02 projected future value never enters wealth through parser and commit',()=>{const p=parseStructuredTable('Savings, AUD 1200000, 2026-09-19, Projected future value').proposals[0];recordBalanceObservation(db,obs(p));expect(getSharedFinancialSummary(db,{asOfDate:'2026-09-20'}).net_worth_cents_by_currency.AUD||0).toBe(0);});
it('P03 rejects impossible calendar date at API boundary',async()=>{expect((await commit(req({items:[obs({effective_date:'2026-02-31'})]}))).status).toBe(400);});
it('P04 normalises Australian hyphen date',()=>{expect(parseStructuredTable('Savings | AUD 100 | 19-09-2026 | Current').proposals[0].effective_date).toBe('2026-09-19');});
it('P05 honours Balance header rather than trailing account number',()=>{expect(parseStructuredTable('Account,Balance,Currency,Date,Account Number\nSavings,100,AUD,2026-09-19,123456').proposals[0].amount_cents).toBe(10000);});
it('P06 preserves negative liability or requires sign confirmation',()=>{const p=parseStructuredTable('Credit Card, AUD -50, 2026-09-19, Credit balance').proposals[0];expect(p.amount_cents<0 || p.unresolved_fields.length>0).toBe(true);});
it('P07 incomplete coverage cannot produce a complete total',()=>{const s=getSharedFinancialSummary(db,{reportingCurrency:'AUD'});expect(s.coverage_notes.length).toBeGreaterThan(0);expect(s.converted_net_worth?.is_complete).toBe(false);});
it('P08 credit limit must not generate a ledger discrepancy',()=>{const o=recordBalanceObservation(db,obs({balance_kind:'credit_limit'}));expect(getReconciliationComparison(db,account,o).is_comparable).toBe(false);});
it('P09 repeated identical source event is idempotent',async()=>{const body={items:[obs({source_reference:'same-row',source_batch_id:'same-batch'})]};expect((await commit(req(body))).status).toBe(200);expect((await commit(req(body))).status).toBe(200);expect((db.prepare('SELECT COUNT(*) n FROM m1_balance_observations').get() as any).n).toBe(1);});
it('P10 same-account multi-kind batch accepts one reviewed revision atomically',async()=>{const response=await commit(req({items:[obs({expected_balance_revision:1}),obs({balance_kind:'credit_limit',expected_balance_revision:1})]}));expect(response.status).toBe(200);expect((db.prepare('SELECT COUNT(*) n FROM m1_balance_observations').get() as any).n).toBe(2);});
it('P11 ambiguous identical names across owners remain unmatched',async()=>{const business=createEntity(db,{name:'Business',type:'business',currency:'AUD'});createAccount(db,{entity_id:business.id,name:'Savings',type:'asset',sub_type:'savings',currency:'AUD',tracking_mode:'balance'});const response=await parse(req({text:'Savings, AUD 100, 2026-09-19, Current'}));expect((await response.json()).proposals[0].matched_account_id).toBeNull();});
it('P12 rejects excessive JPY precision instead of silent rounding',()=>{const p=parseStructuredTable('Tokyo, JPY 100.50, 2026-09-19, Current').proposals[0];expect(!p || p.unresolved_fields.length>0).toBe(true);});
it('P13 round-trips corrected observations and mapping through vault',async()=>{recordBalanceObservation(db,obs());recordBalanceObservation(db,obs({amount_cents:11000}));recordSourceMapping(db,{accountId:account,provider:'test',sourceAccountId:'123'});const exported=await (await exportVault(new Request('http://localhost/api/vault'))).json();const fresh=createTestDb();initAccountingSchema(fresh);setTestDb(fresh);try{const response=await restoreVault(req({action:'bulk_restore',...exported}));const result=await response.json();expect({status:response.status,error:result.error}).toEqual({status:200,error:undefined});expect(fresh.prepare('SELECT * FROM m1_balance_observations ORDER BY id').all()).toEqual(db.prepare('SELECT * FROM m1_balance_observations ORDER BY id').all());}finally{fresh.close();setTestDb(db);}});
it('P14 vault rejects observation whose currency differs from account',async()=>{recordBalanceObservation(db,obs());const exported=await (await exportVault(new Request('http://localhost/api/vault'))).json();exported.vault.balance_observations[0].currency='JPY';const response=await restoreVault(req({action:'bulk_restore',...exported}));expect(response.status).toBe(400);});
it('P15 ledger remains unchanged after balance observations',()=>{const before=db.prepare('SELECT * FROM m1_transactions').all();recordBalanceObservation(db,obs());expect(db.prepare('SELECT * FROM m1_transactions').all()).toEqual(before);expect(db.prepare('SELECT * FROM m1_journal_entries').all()).toEqual([]);});
it('P16 batch with invalid second item rolls back first item',async()=>{const r=await commit(req({items:[obs(),obs({currency:'JPY'})]}));expect(r.status).toBe(400);expect((db.prepare('SELECT COUNT(*) n FROM m1_balance_observations').get() as any).n).toBe(0);});
it('P17 later-date identical amount updates freshness and retains history',()=>{recordBalanceObservation(db,obs({effective_date:'2026-08-01'}));recordBalanceObservation(db,obs());const s=getSharedFinancialSummary(db,{asOfDate:'2026-09-20'});expect(s.accounts_included[0].effective_date).toBe('2026-09-19');expect(s.net_worth_cents_by_currency.AUD).toBe(10000);expect((db.prepare('SELECT COUNT(*) n FROM m1_balance_observations').get() as any).n).toBe(2);});
it('P18 importing older statement keeps newer current wealth',()=>{recordBalanceObservation(db,obs());recordBalanceObservation(db,obs({effective_date:'2026-06-01',amount_cents:8000}));expect(getSharedFinancialSummary(db,{asOfDate:'2026-09-20'}).net_worth_cents_by_currency.AUD).toBe(10000);});
it('P19 plain observation and mapping backup restore succeeds',async()=>{recordBalanceObservation(db,obs());recordSourceMapping(db,{accountId:account,provider:'test',sourceAccountId:'123'});const exported=await (await exportVault(new Request('http://localhost/api/vault'))).json();const fresh=createTestDb();initAccountingSchema(fresh);setTestDb(fresh);try{expect((await restoreVault(req({action:'bulk_restore',...exported}))).status).toBe(200);expect(fresh.prepare('SELECT * FROM m1_balance_observations').all()).toEqual(db.prepare('SELECT * FROM m1_balance_observations').all());expect(fresh.prepare('SELECT * FROM m1_account_source_mappings').all()).toEqual(db.prepare('SELECT * FROM m1_account_source_mappings').all());expect((fresh.prepare('SELECT tracking_mode FROM m1_accounts WHERE id=?').get(account) as any).tracking_mode).toBe('balance');}finally{fresh.close();setTestDb(db);}});
