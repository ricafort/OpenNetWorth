# ===========================================
# OpenNetWorth Environment Configuration
# ===========================================
# OpenNetWorth is 100% local-first and private by default.
# You can run the app immediately with ZERO environment variables!
# Copy this file to .env.local if you want to customize your Local LLM or optional backends.
# cp .env.example .env.local

# -----------------------------------------------------------------------------
# 1. Local LLM Configuration (Default & Recommended - 100% Private, On-Device)
# -----------------------------------------------------------------------------
# OpenNetWorth auto-detects LM Studio (port 1234), Ollama (port 11434), and Strata (port 8080).
# You can also configure them explicitly here:

# Endpoint URL for your local LLM inference server
# LM Studio default: http://localhost:1234/v1
# Ollama default:    http://localhost:11434
# Strata default:    http://localhost:8080/v1
LOCAL_LLM_URL=http://localhost:1234/v1

# Target model name loaded in your local inference engine
# Examples:
#   LM Studio: qwen3.8-27b-gsq-rco, meta/muse-glimmer, mistral-7b-instruct
#   Ollama:    llama3.2:latest, mistral:latest, qwen2.5:7b
#   Strata:    qwen3.8-flash-next-iq3_s (see the model name on Strata's About tab)
LOCAL_LLM_MODEL=

# Provider type: 'lmstudio' | 'ollama' | 'strata' | 'openai-compatible' (leave blank for auto-detect)
LOCAL_LLM_PROVIDER=

# -----------------------------------------------------------------------------
# 2. Optional: Fallback Cloud AI (Google Gemini)
# -----------------------------------------------------------------------------
# If you don't have hardware capable of running local models, you can optionally
# configure a Google Gemini key. (If missing, OpenNetWorth uses your Local LLM
# or built-in offline rule heuristics).
# GEMINI_API_KEY=your-gemini-key-here

# -----------------------------------------------------------------------------
# 3. Optional: Market Data & Bank Integrations
# -----------------------------------------------------------------------------
# Plaid Bank Integration (leave blank for local manual entry or sample sandbox)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Alpha Vantage (Stock Prices - optional, mock data provided if missing)
NEXT_PUBLIC_ALPHA_VANTAGE_KEY=

# -----------------------------------------------------------------------------
# 4. Optional: OpenTax-AU document extraction (local PDF invoice parsing)
# -----------------------------------------------------------------------------
# Path to a local OpenTax-AU checkout. Its Python package is used by
# scripts/opentax_reader.py to extract invoice data from PDFs. If unset,
# PDF extraction is unavailable and related integration tests are skipped.
OPENTAX_PATH=
# Optional: explicit python executable (defaults to $OPENTAX_PATH/.venv python)
OPENTAX_PYTHON=
